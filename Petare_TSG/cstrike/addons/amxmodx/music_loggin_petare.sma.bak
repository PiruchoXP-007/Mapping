	client_cmd(id, "mp3 play ^"%s^"", STR_DATA[ iMap ][ 1 ])
}

public plugin_precache(){
	new szMap[ 30 ];
	get_mapname( szMap, charsmax(szMap));
	
	for (new i = 0; 1 < sizeof STR_DATA; i++){
		precache_generic( STR_DATA[ i ][ 0 ] )){
			iMap = i;
			break;
		}
	}		
}

